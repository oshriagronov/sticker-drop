# Keystore Configuration Template
# Copy this file to `keystore.properties` and fill in your signing credentials.
# `keystore.properties` is listed in .gitignore and MUST NOT be committed to Git.
#
# Alternatively, set these keys as environment variables in your CI/CD pipeline (e.g. GitHub Actions).

KEYSTORE_FILE=release-key.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password

# ==============================================================================
# How to generate a release key via command line (run from project root):
# ==============================================================================
# keytool -genkey -v -keystore release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias stickerdrop_key
# ==============================================================================
